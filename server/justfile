# Murmur server justfile
# Run these recipes with the Windows build of `just` from any clone location.

set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

server_dir := justfile_directory()

default:
    @just --list

test:
    Set-Location '{{server_dir}}'; uv run pytest

start:
    Set-Location '{{server_dir}}'; uv run python -m main

start-bg:
    Start-Process -FilePath 'uv' -ArgumentList 'run','python','-m','main' -WorkingDirectory '{{server_dir}}' -WindowStyle Hidden

# Stop only the Python process identified by Murmur's PID file.
stop:
    $candidates = @((Join-Path $env:APPDATA 'murmur\server.pid'), (Join-Path $env:LOCALAPPDATA 'murmur\server.pid')); $pidFile = $candidates | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1; if (-not $pidFile) { Write-Host 'Murmur is not running (no PID file).'; exit 0 }; $data = Get-Content -LiteralPath $pidFile -Raw | ConvertFrom-Json; $owned = Get-CimInstance Win32_Process -Filter "ProcessId = $($data.pid)" -ErrorAction SilentlyContinue; if (-not $owned) { Remove-Item -LiteralPath $pidFile -Force; Write-Host 'Removed stale Murmur PID file.'; exit 0 }; if ($owned.Name -notmatch '^python(w)?\.exe$' -or $owned.CommandLine -notmatch '(?:-m\s+main|[\\/]src[\\/]main\.py)') { throw "PID $($data.pid) is not an identifiable Murmur server; refusing to stop it." }; Stop-Process -Id $data.pid; Write-Host "Stopped Murmur server PID $($data.pid)."

status:
    $candidates = @((Join-Path $env:APPDATA 'murmur\server.pid'), (Join-Path $env:LOCALAPPDATA 'murmur\server.pid')); $pidFile = $candidates | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1; if (-not $pidFile) { Write-Host 'Murmur is not running.'; exit 0 }; $data = Get-Content -LiteralPath $pidFile -Raw | ConvertFrom-Json; $process = Get-Process -Id $data.pid -ErrorAction SilentlyContinue; if (-not $process) { Write-Host 'Murmur PID file is stale.'; exit 1 }; [pscustomobject]@{ PID = $data.pid; Port = $data.port; StartedAt = $data.startedAt; Process = $process.ProcessName } | Format-List
