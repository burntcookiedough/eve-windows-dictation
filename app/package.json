{
  "name": "murmur",
  "version": "0.6.0",
  "description": "Desktop voice transcription app",
  "repository": {
    "type": "git",
    "url": "https://github.com/dikkadev/murmur.git"
  },
  "main": "dist/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "node scripts/dev.js",
    "dev:vite": "vite",
    "dev:main": "bun run build:main --watch",
    "dev:electron": "NODE_ENV=development node scripts/wait-for-vite.js && electron .",
    "build": "bun run build:main && bun run build:renderer",
    "build:main": "node scripts/build-main.js",
    "build:renderer": "vite build",
    "test:history": "node tests/run-history-insights-check.mjs",
    "preview": "vite preview",
    "package": "bun run build && electron-builder",
    "package:win": "bun run build && electron-builder --win --publish never",
    "clear-data": "node scripts/clear-data.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "electron-store": "^11.0.2",
    "svelte": "^5.56.4",
    "tailwind-merge": "^3.6.0",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.21.0"
  },
  "overrides": {
    "fast-uri": "3.1.3"
  },
  "build": {
    "appId": "com.murmur.app",
    "productName": "Murmur",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "settings.json",
          "src/**/*",
          ".runtime/**/*",
          ".venv/**/*",
          "!.venv/Scripts/pip*.exe",
          "!.venv/Lib/site-packages/pip/**",
          "!.venv/Lib/site-packages/pip-*.dist-info/**",
          "!.venv/Lib/site-packages/wheel/**",
          "!.venv/Lib/site-packages/wheel-*.dist-info/**",
          "!.venv/Lib/site-packages/setuptools/**",
          "!.venv/Lib/site-packages/setuptools-*.dist-info/**",
          "!.venv/Lib/site-packages/**/test/**",
          "!.venv/Lib/site-packages/**/tests/**",
          "!.venv/Lib/site-packages/**/*.lib",
          "!.venv/Lib/site-packages/torch/include/**",
          "!.runtime/include/**",
          "!.runtime/libs/**",
          "!.runtime/Lib/test/**",
          "!.runtime/Lib/idlelib/**",
          "!.runtime/Lib/tkinter/**",
          "!.runtime/tcl/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": "nsis-web",
      "icon": "resources/icon.ico"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
