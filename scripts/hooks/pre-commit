#!/bin/sh

# Git matches staged paths directly, including paths with embedded newlines.
git diff --cached --quiet --diff-filter=ACMRTUXB -- \
    ':(glob,icase)**/*.wav' ':(glob,icase)**/*.flac' \
    ':(glob,icase)**/*.mp3' ':(glob,icase)**/*.webm' \
    ':(glob,icase)**/*.ogg' ':(glob,icase)**/*.m4a' \
    ':(glob,icase)**/.env*' ':(glob,icase)**/*transcript*.json' \
    ':(glob,icase)**/*transcript*.jsonl' \
    ':(glob,icase)**/profiles/**' ':(glob,icase)**/user-data/**'
case $? in
    0) ;;
    1)
        echo "Commit blocked: staged files match private-data patterns. Review and unstage them." >&2
        exit 1
        ;;
    *) exit 1 ;;
esac

exec git diff --cached --check
